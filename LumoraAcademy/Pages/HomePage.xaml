<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LumoraAcademy.Pages.HomePage"
             Title="Home"
             BackgroundColor="{StaticResource ContentBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ===== Top bar ===== -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  Padding="40,16"
                  BackgroundColor="{StaticResource CardBackground}">

                <Image Grid.Column="0"
                       Source="lumora_mark.png"
                       WidthRequest="40"
                       HeightRequest="40" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="0"
                                     VerticalOptions="Center">
                    <Label Text="LUMORA"
                           FontSize="16"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           TextColor="{StaticResource Brown700}" />
                    <Label Text="Educational Institute"
                           FontSize="10"
                           TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Login"
                        Style="{StaticResource SmallOutlineButtonStyle}"
                        Clicked="OnLoginButtonClicked" />
            </Grid>

            <BoxView HeightRequest="1"
                     Color="{StaticResource CardBorder}" />

            <!-- ===== Hero ===== -->
            <Grid HeightRequest="440">

                <!-- The brown backdrop is drawn here rather than being part of a
                     picture, so it stretches to any window width without cropping. -->
                <Border StrokeThickness="0" Padding="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Brown900}" Offset="0.0" />
                            <GradientStop Color="{StaticResource Brown700}" Offset="0.5" />
                            <GradientStop Color="{StaticResource Brown400}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Soft light, for a little depth -->
                <Ellipse Fill="{StaticResource BrandCream}"
                         Opacity="0.05"
                         WidthRequest="420"
                         HeightRequest="420"
                         HorizontalOptions="Start"
                         VerticalOptions="Start"
                         Margin="-140,-160,0,0" />
                <Ellipse Fill="{StaticResource AccentGold}"
                         Opacity="0.08"
                         WidthRequest="300"
                         HeightRequest="300"
                         HorizontalOptions="End"
                         VerticalOptions="End"
                         Margin="0,0,-80,-140" />

                <!-- The artwork sits on top, sized to fit, so it is never cut off
                     however wide the window is made. -->
                <Image Source="hero_art.png"
                       Aspect="AspectFit"
                       HeightRequest="400"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Margin="0,0,40,0" />

                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Start"
                                     Spacing="14"
                                     MaximumWidthRequest="560"
                                     Padding="56,0">

                    <Border Background="{StaticResource AccentGold}"
                            StrokeThickness="0"
                            Padding="12,5"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label Text="STUDENT MANAGEMENT SYSTEM"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="1.5"
                               TextColor="{StaticResource Brown900}" />
                    </Border>

                    <Label Text="Learning beyond the syllabus"
                           FontSize="42"
                           FontAttributes="Bold"
                           LineHeight="1.15"
                           TextColor="{StaticResource TextOnDark}" />

                    <Label Text="One place for students, teachers, classes, attendance and fees at Lumora Educational Institute."
                           FontSize="15"
                           LineHeight="1.5"
                           TextColor="{StaticResource Brown100}" />

                    <Button Text="Login"
                            Clicked="OnLoginButtonClicked"
                            BackgroundColor="{StaticResource BrandCream}"
                            TextColor="{StaticResource Brown800}"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="8"
                            HeightRequest="48"
                            WidthRequest="170"
                            Margin="0,12,0,0"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>

            <!-- ===== Mission and Vision ===== -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="24"
                  Padding="40,36,40,44">

                <!-- Mission card -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <Grid WidthRequest="40"
                              HeightRequest="40"
                              HorizontalOptions="Start">
                            <Ellipse Fill="{StaticResource BrandCream}" />
                            <Label Text="&#xE7C1;"
                                   Style="{StaticResource IconStyle}"
                                   FontSize="17"
                                   TextColor="{StaticResource Brown600}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Label Text="Mission"
                               Style="{StaticResource CardTitleStyle}" />

                        <Label Style="{StaticResource CardBodyStyle}"
                               Text="At Lumora, education goes beyond the syllabus. We create engaging learning experiences that build knowledge, confidence, creativity, critical thinking, and life skills. With personalized guidance, we help every student discover their strengths and become confident individuals ready for life beyond the classroom." />
                    </VerticalStackLayout>
                </Border>

                <!-- Vision card -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <Grid WidthRequest="40"
                              HeightRequest="40"
                              HorizontalOptions="Start">
                            <Ellipse Fill="{StaticResource BrandCream}" />
                            <Label Text="&#xE7B3;"
                                   Style="{StaticResource IconStyle}"
                                   FontSize="17"
                                   TextColor="{StaticResource Brown600}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Label Text="Vision"
                               Style="{StaticResource CardTitleStyle}" />

                        <Label Style="{StaticResource CardBodyStyle}"
                               Text="To illuminate every learner's potential by creating a generation that learns beyond the syllabus, thinks beyond boundaries, and grows beyond expectations." />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ===== Footer ===== -->
            <Grid Padding="40,18"
                  BackgroundColor="{StaticResource Brown800}">
                <Label Text="Lumora Educational Institute  -  Shaping Futures"
                       FontSize="11"
                       TextColor="{StaticResource Brown200}"
                       HorizontalOptions="Center" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
