<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.AdminEventsPage"
             Title="Event Management"
             BackgroundColor="{StaticResource ContentBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Upcoming Events" />

        <!-- The page, with the event form sitting on top of it -->
        <Grid Grid.Column="1">

            <ScrollView>
                <VerticalStackLayout Padding="36,32" Spacing="20">

                    <!-- Heading, view switch and the create button -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Event Management" Style="{StaticResource PageTitleStyle}" />
                            <Label Text="Manage and schedule the institute calendar."
                                   Style="{StaticResource PageSubtitleStyle}" />
                        </VerticalStackLayout>

                        <!-- Calendar / List switch. Both sides always work. -->
                        <Border Grid.Column="1"
                                Style="{StaticResource FieldBoxStyle}"
                                HeightRequest="42"
                                Padding="4"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="3">
                                <Border x:Name="CalendarTab" Padding="14,0" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShowCalendar" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label x:Name="CalendarTabIcon" Text="&#xE787;" Style="{StaticResource IconStyle}" FontSize="11" />
                                        <Label x:Name="CalendarTabText" Text="Calendar" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border x:Name="ListTab" Padding="14,0" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShowList" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label x:Name="ListTabIcon" Text="&#xE8FD;" Style="{StaticResource IconStyle}" FontSize="11" />
                                        <Label x:Name="ListTabText" Text="List" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </Border>

                        <Button Grid.Column="2"
                                Text="+ Create New Event"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalOptions="Center"
                                Clicked="OnOpenCreateClicked" />
                    </Grid>

                    <!-- ===== Calendar view (shown first) ===== -->
                    <Grid x:Name="CalendarView" ColumnDefinitions="*,280" ColumnSpacing="20">

                        <controls:MonthCalendarView x:Name="Calendar"
                                                    Grid.Column="0"
                                                    VerticalOptions="Start" />

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18" VerticalOptions="Start">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Coming Up" Style="{StaticResource SectionTitleStyle}" FontSize="15" />
                                <BoxView Style="{StaticResource RowDividerStyle}" />

                                <VerticalStackLayout x:Name="UpcomingList" Spacing="14">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="3,*" ColumnSpacing="10">
                                                <BoxView Grid.Column="0" Color="{StaticResource BrandPrimary}" CornerRadius="2" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                    <Label Text="{Binding DateText}" Style="{StaticResource SmallMutedStyle}" TextColor="{StaticResource TextHeading}" />
                                                    <Label Text="{Binding Title}" Style="{StaticResource BodyBoldStyle}" FontSize="13" />
                                                    <Label Text="{Binding Time}" Style="{StaticResource SmallMutedStyle}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label x:Name="NoUpcomingLabel"
                                       Text="Nothing coming up yet."
                                       Style="{StaticResource SmallMutedStyle}"
                                       IsVisible="False" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- ===== List view ===== -->
                    <VerticalStackLayout x:Name="ListView" Spacing="10" IsVisible="False">
                        <Border Style="{StaticResource CardTightStyle}">
                            <VerticalStackLayout>
                                <Grid Padding="20,14">
                                    <Label Text="All Events" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                                </Grid>

                                <Grid Style="{StaticResource TableHeaderRowStyle}"
                                      ColumnDefinitions="1.6*,1.5*,1.2*,0.9*,0.7*">
                                    <Label Grid.Column="0" Text="EVENT NAME" Style="{StaticResource TableHeaderStyle}" />
                                    <Label Grid.Column="1" Text="DATE &amp; TIME" Style="{StaticResource TableHeaderStyle}" />
                                    <Label Grid.Column="2" Text="LOCATION" Style="{StaticResource TableHeaderStyle}" />
                                    <Label Grid.Column="3" Text="CATEGORY" Style="{StaticResource TableHeaderStyle}" />
                                    <Label Grid.Column="4" Text="ACTIONS" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="End" />
                                </Grid>

                                <VerticalStackLayout x:Name="RowList">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout>
                                                <Grid Style="{StaticResource TableRowStyle}"
                                                      ColumnDefinitions="1.6*,1.5*,1.2*,0.9*,0.7*">
                                                    <Label Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TableCellBoldStyle}" FontSize="12" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                        <Label Text="{Binding DateText}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                                        <Label Text="{Binding Time}" Style="{StaticResource SmallMutedStyle}" FontSize="10" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding Location}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                                    <controls:StatusBadge Grid.Column="3" Text="{Binding Category}" />
                                                    <HorizontalStackLayout Grid.Column="4" Spacing="12" HorizontalOptions="End">
                                                        <Label Text="&#xE70F;" Style="{StaticResource IconStyle}" FontSize="13">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnEditEventTapped" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                        <Label Text="&#xE74D;" Style="{StaticResource IconStyle}" FontSize="13">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnDeleteEventTapped" />
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </HorizontalStackLayout>
                                                </Grid>
                                                <BoxView Style="{StaticResource RowDividerStyle}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label x:Name="NoEventsLabel"
                                       Text="No events yet. Click Create New Event to add one."
                                       Style="{StaticResource MutedStyle}"
                                       Padding="20,16"
                                       IsVisible="False" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ===== The event form, used for both creating and editing ===== -->
            <Grid x:Name="EventPopup"
                  BackgroundColor="#99281C12"
                  IsVisible="False">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClosePopup" />
                </Grid.GestureRecognizers>

                <Border Style="{StaticResource CardStyle}"
                        Padding="0"
                        WidthRequest="680"
                        MaximumHeightRequest="700"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="Auto,Auto,*,Auto">

                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="24,20,24,16">
                            <Label x:Name="PopupTitle" Text="Create New Event" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                            <Label Grid.Column="1" Text="&#xE711;" Style="{StaticResource IconStyle}" FontSize="15">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnClosePopup" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <BoxView Grid.Row="1" Style="{StaticResource RowDividerStyle}" />

                        <ScrollView Grid.Row="2">
                            <VerticalStackLayout Spacing="16" Padding="24,20">

                                <Border x:Name="PopupErrorBox" Style="{StaticResource ErrorBoxStyle}">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="&#xE783;" Style="{StaticResource IconStyle}" TextColor="{StaticResource StatusRedText}" />
                                        <Label x:Name="PopupErrorLabel" Style="{StaticResource ErrorTextStyle}" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                        <HorizontalStackLayout Spacing="3">
                                            <Label Text="Event Title" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                            <Label Style="{StaticResource RequiredMarkStyle}" />
                                        </HorizontalStackLayout>
                                        <Border Style="{StaticResource FieldBoxStyle}">
                                            <Entry x:Name="TitleEntry" Placeholder="Spring Science Fair" Style="{StaticResource FieldEntryStyle}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                        <HorizontalStackLayout Spacing="3">
                                            <Label Text="Category" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                            <Label Style="{StaticResource RequiredMarkStyle}" />
                                        </HorizontalStackLayout>
                                        <controls:DropDownField x:Name="CategoryPicker" Title="Select category" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                        <HorizontalStackLayout Spacing="3">
                                            <Label Text="Date" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                            <Label Style="{StaticResource RequiredMarkStyle}" />
                                        </HorizontalStackLayout>
                                        <controls:DateField x:Name="DatePicker" />
                                    </VerticalStackLayout>

                                    <!-- The time is a duration, for example 8:00 PM - 10:00 PM -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                        <Label Text="Time" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                                            <controls:TimeField x:Name="FromTimePicker" Grid.Column="0" />
                                            <Label Grid.Column="1" Text="to" Style="{StaticResource MutedStyle}" VerticalOptions="Center" />
                                            <controls:TimeField x:Name="ToTimePicker" Grid.Column="2" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6">
                                        <HorizontalStackLayout Spacing="3">
                                            <Label Text="Location" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                            <Label Style="{StaticResource RequiredMarkStyle}" />
                                        </HorizontalStackLayout>
                                        <Border Style="{StaticResource FieldBoxStyle}">
                                            <Entry x:Name="LocationEntry" Placeholder="Main Hall" Style="{StaticResource FieldEntryStyle}" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6">
                                        <Label Text="Visible to" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                        <HorizontalStackLayout Spacing="18" VerticalOptions="Center">
                                            <RadioButton x:Name="StaffRadio" Content="All staff" GroupName="Visibility" IsChecked="True"
                                                         FontSize="13" TextColor="{StaticResource TextHeading}" />
                                            <RadioButton Content="Admin only" GroupName="Visibility"
                                                         FontSize="13" TextColor="{StaticResource TextHeading}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Description" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                    <Border Style="{StaticResource TextAreaBoxStyle}" HeightRequest="90">
                                        <Editor x:Name="DescriptionEditor" Placeholder="What is this event about?" Style="{StaticResource FieldEditorStyle}" />
                                    </Border>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </ScrollView>

                        <Grid Grid.Row="3" Padding="24,16,24,20">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                                <Button Text="Cancel" Style="{StaticResource OutlineButtonStyle}" Clicked="OnClosePopup" />
                                <Button x:Name="SaveButton" Text="Save Event" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveEventClicked" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
