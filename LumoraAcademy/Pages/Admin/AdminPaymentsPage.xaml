<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.AdminPaymentsPage"
             Title="Payments"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Payments" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,32"
                                 Spacing="22">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Payment Tracking" Style="{StaticResource PageTitleStyle}" />
                        <Label Text="Overview of student fee statuses for current academic term." Style="{StaticResource PageSubtitleStyle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Edit Payment"
                            Style="{StaticResource SmallPrimaryButtonStyle}"
                            VerticalOptions="Start"
                            Clicked="OnEditPaymentClicked" />
                </Grid>

                <!-- Four statistics -->
                <Grid ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="14">
                    <controls:StatCard Grid.Column="0" Title="Total Expected" Value="$124,500" Subtitle="Current Month" Icon="&#xE8C7;" />
                    <controls:StatCard Grid.Column="1" Title="Collected (Paid)" Value="$98,200" Subtitle="79% of total" Icon="&#xE73E;" />
                    <controls:StatCard Grid.Column="2" Title="Pending" Value="$21,000" Subtitle="112 students" Icon="&#xE823;" />
                    <controls:StatCard Grid.Column="3" Title="Overdue / At Risk" Value="$5,300" Subtitle="Action Required" Icon="&#xE7BA;" />
                </Grid>

                <!-- Student accounts table -->
                <Border Style="{StaticResource CardTightStyle}">
                    <VerticalStackLayout>

                        <Grid Padding="20,14">
                            <Label Text="Student Accounts" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                        </Grid>

                        <Grid Style="{StaticResource TableHeaderRowStyle}"
                              ColumnDefinitions="1.6*,1*,1.3*,1.2*,1.3*,0.8*">
                            <Label Grid.Column="0" Text="Student Name / ID" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="1" Text="Monthly Fee" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="2" Text="Outstanding Balance" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="3" Text="Last Paid Date" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="4" Text="Status" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="5" Text="Actions" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="End" />
                        </Grid>

                        <VerticalStackLayout x:Name="RowList">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid Style="{StaticResource TableRowStyle}"
                                              ColumnDefinitions="1.6*,1*,1.3*,1.2*,1.3*,0.8*">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" Style="{StaticResource TableCellBoldStyle}" FontSize="12" />
                                                <Label Text="{Binding Id}" Style="{StaticResource SmallMutedStyle}" FontSize="10" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding MonthlyFee}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                            <Label Grid.Column="2" Text="{Binding Outstanding}" Style="{StaticResource TableCellBoldStyle}" FontSize="12" />
                                            <Label Grid.Column="3" Text="{Binding LastPaid}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                            <controls:StatusBadge Grid.Column="4" Text="{Binding Status}" />
                                            <Label Grid.Column="5"
                                                   Text="{Binding Action}"
                                                   Style="{StaticResource TableCellBoldStyle}"
                                                   FontSize="12"
                                                   HorizontalOptions="End">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRowActionTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                        <BoxView Style="{StaticResource RowDividerStyle}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto"
                              Padding="20,12">
                            <Label Grid.Column="0" Text="Showing 1 to 4 of 1,234 entries" Style="{StaticResource SmallMutedStyle}" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                <Button Text="Prev" Style="{StaticResource SmallOutlineButtonStyle}" HeightRequest="26" FontSize="10" TextColor="{StaticResource TextLight}" />
                                <Border Style="{StaticResource PageNumberActiveStyle}">
                                    <Label Text="1" FontSize="11" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border Style="{StaticResource PageNumberStyle}">
                                    <Label Text="2" FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border Style="{StaticResource PageNumberStyle}">
                                    <Label Text="3" FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Button Text="Next" Style="{StaticResource SmallOutlineButtonStyle}" HeightRequest="26" FontSize="10" />
                            </HorizontalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
