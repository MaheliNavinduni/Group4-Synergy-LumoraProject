<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.AdminAcademicsPage"
             Title="Academics"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Academics" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,32"
                                 Spacing="20">

                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="Subject Management"
                           Style="{StaticResource PageTitleStyle}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="Manage Classes"
                            Style="{StaticResource SmallOutlineButtonStyle}"
                            Clicked="OnClassesClicked" />
                    <Button Grid.Column="2"
                            Text="+ Add New Subject"
                            Style="{StaticResource SmallPrimaryButtonStyle}"
                            Clicked="OnAddSubjectClicked" />
                    <Button Grid.Column="3"
                            Text="Go Back"
                            Style="{StaticResource SmallPrimaryButtonStyle}"
                            BackgroundColor="{StaticResource BrandPrimaryDark}"
                            Clicked="OnGoBackClicked" />
                </Grid>

                <!-- One card per subject -->
                <VerticalStackLayout x:Name="SubjectList"
                                     Spacing="10"
                                     MaximumWidthRequest="620"
                                     HorizontalOptions="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="16,12">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="12">
                                    <Label Grid.Column="0"
                                           Text="&#xE82D;"
                                           Style="{StaticResource IconStyle}"
                                           TextColor="{StaticResource BrandPrimary}"
                                           VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2">
                                        <Label Text="{Binding DisplayName}"
                                               Style="{StaticResource BodyBoldStyle}" />
                                        <Label Text="{Binding Curriculum}"
                                               Style="{StaticResource SmallMutedStyle}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
