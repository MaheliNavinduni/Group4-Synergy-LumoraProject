<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.AddSubjectPage"
             Title="Add New Subject"
             BackgroundColor="{StaticResource ContentBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Academics" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,28"
                                 Spacing="18"
                                 MaximumWidthRequest="1100"
                                 HorizontalOptions="Fill">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Academics  /  Subjects"
                               Style="{StaticResource SmallMutedStyle}" />
                        <Label Text="Add New Subject"
                               Style="{StaticResource PageTitleStyle}" />
                        <Label Text="A subject is the thing that is taught. Classes are built from subjects on the Classes page."
                               Style="{StaticResource PageSubtitleStyle}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Cancel"
                            Style="{StaticResource OutlineButtonStyle}"
                            VerticalOptions="Center"
                            Clicked="OnCancelClicked" />
                    <Button Grid.Column="2"
                            Text="Save Subject"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalOptions="Center"
                            Clicked="OnSaveClicked" />
                </Grid>

                <Grid ColumnDefinitions="*,300" ColumnSpacing="20">

                    <!-- ===== The form ===== -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                        <VerticalStackLayout Spacing="16">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xE8A5;" Style="{StaticResource IconStyle}" TextColor="{StaticResource BrandPrimary}" />
                                <Label Text="Subject Information" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                            </HorizontalStackLayout>
                            <BoxView Style="{StaticResource RowDividerStyle}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18" RowDefinitions="Auto,Auto" RowSpacing="14">

                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="Subject Name" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                        <Label Style="{StaticResource RequiredMarkStyle}" />
                                    </HorizontalStackLayout>
                                    <Border Style="{StaticResource FieldBoxStyle}">
                                        <Entry x:Name="SubjectNameEntry" Placeholder="For example Combined Maths" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="Subject Code" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                        <Label Style="{StaticResource RequiredMarkStyle}" />
                                    </HorizontalStackLayout>
                                    <Border Style="{StaticResource FieldBoxStyle}">
                                        <Entry x:Name="SubjectCodeEntry" Placeholder="For example MAT-101" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                    <Label Text="A short code, used on reports. It must not already be in use."
                                           Style="{StaticResource SmallMutedStyle}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="Curriculum" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                        <Label Style="{StaticResource RequiredMarkStyle}" />
                                    </HorizontalStackLayout>
                                    <controls:DropDownField x:Name="CurriculumPicker" Title="Select curriculum" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ===== Side panel ===== -->
                    <VerticalStackLayout Grid.Column="1" Spacing="18">

                        <controls:StatCard x:Name="TotalCard"
                                           Title="TOTAL SUBJECTS"
                                           Value="0"
                                           Subtitle="Already set up"
                                           Icon="&#xE8A5;"
                                           Accent="1" />

                        <Border Style="{StaticResource CardTightStyle}">
                            <VerticalStackLayout>
                                <Grid Padding="18,14">
                                    <Label Text="Subjects so far" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                                </Grid>
                                <BoxView Style="{StaticResource RowDividerStyle}" />

                                <VerticalStackLayout x:Name="SubjectList">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout>
                                                <Grid ColumnDefinitions="*,Auto" Padding="18,10">
                                                    <Label Text="{Binding Name}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                                    <Label Grid.Column="1" Text="{Binding Code}" Style="{StaticResource TableCellMutedStyle}" />
                                                </Grid>
                                                <BoxView Style="{StaticResource RowDividerStyle}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label x:Name="NoSubjectsLabel"
                                       Text="No subjects yet. This one will be the first."
                                       Style="{StaticResource MutedStyle}"
                                       Padding="18,14"
                                       IsVisible="False" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
