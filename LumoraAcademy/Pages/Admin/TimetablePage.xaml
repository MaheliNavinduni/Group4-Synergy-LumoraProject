<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.TimetablePage"
             Title="Timetable"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Teachers" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,32"
                                 Spacing="20"
                                 MaximumWidthRequest="900"
                                 HorizontalOptions="Start">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Manage Timetable" Style="{StaticResource PageTitleStyle}" />
                    <Label x:Name="SubtitleLabel" Text="" Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>

                <!-- Add a lesson -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Add Lesson" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                        <BoxView Style="{StaticResource RowDividerStyle}" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="12">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                <Label Text="Subject" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                <Border Style="{StaticResource FieldBoxStyle}">
                                    <Picker x:Name="SubjectPicker" Style="{StaticResource FieldPickerStyle}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                <Label Text="Class" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                <Border Style="{StaticResource FieldBoxStyle}">
                                    <Picker x:Name="ClassPicker" Style="{StaticResource FieldPickerStyle}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="6">
                                <Label Text="Day" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                <Border Style="{StaticResource FieldBoxStyle}">
                                    <Picker x:Name="DayPicker" Style="{StaticResource FieldPickerStyle}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                                <Label Text="Start Time" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                <Border Style="{StaticResource FieldBoxStyle}">
                                    <TimePicker x:Name="StartPicker" Time="08:00" FontSize="13" BackgroundColor="Transparent" TextColor="{StaticResource TextHeading}" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                                <Label Text="End Time" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                <Border Style="{StaticResource FieldBoxStyle}">
                                    <TimePicker x:Name="EndPicker" Time="09:30" FontSize="13" BackgroundColor="Transparent" TextColor="{StaticResource TextHeading}" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="6">
                                <Label Text="Room" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                <Border Style="{StaticResource FieldBoxStyle}">
                                    <Entry x:Name="RoomEntry" Placeholder="e.g. 204" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="Add Lesson" Style="{StaticResource PrimaryButtonStyle}" HorizontalOptions="End" Clicked="OnAddClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- Weekly timetable -->
                <Border Style="{StaticResource CardTightStyle}">
                    <VerticalStackLayout>
                        <Grid Padding="20,14">
                            <Label Text="Weekly Timetable" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                        </Grid>
                        <Grid Style="{StaticResource TableHeaderRowStyle}" ColumnDefinitions="1*,1.6*,1.4*,1.2*,0.8*,0.5*">
                            <Label Grid.Column="0" Text="Day" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="1" Text="Time" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="2" Text="Subject" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="3" Text="Class" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="4" Text="Room" Style="{StaticResource TableHeaderStyle}" />
                            <Label Grid.Column="5" Text="" Style="{StaticResource TableHeaderStyle}" />
                        </Grid>
                        <VerticalStackLayout x:Name="RowList">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid Style="{StaticResource TableRowStyle}" ColumnDefinitions="1*,1.6*,1.4*,1.2*,0.8*,0.5*">
                                            <Label Grid.Column="0" Text="{Binding DayName}" Style="{StaticResource TableCellBoldStyle}" FontSize="12" />
                                            <Label Grid.Column="1" Text="{Binding TimeRange}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                            <Label Grid.Column="2" Text="{Binding SubjectName}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                            <Label Grid.Column="3" Text="{Binding ClassName}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                            <Label Grid.Column="4" Text="{Binding Room}" Style="{StaticResource TableCellMutedStyle}" />
                                            <Label Grid.Column="5" Text="&#xE74D;" Style="{StaticResource IconStyle}" FontSize="12" HorizontalOptions="End">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDeleteTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                        <BoxView Style="{StaticResource RowDividerStyle}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label x:Name="EmptyLabel" Text="No lessons yet. Add the first one above." Style="{StaticResource MutedStyle}" Padding="20,12" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Go Back" Style="{StaticResource SmallPrimaryButtonStyle}" HorizontalOptions="End" Clicked="OnGoBackClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
