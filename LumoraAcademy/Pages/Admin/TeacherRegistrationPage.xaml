<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.TeacherRegistrationPage"
             Title="Teacher Registration"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Teachers" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,32"
                                 Spacing="20"
                                 MaximumWidthRequest="760"
                                 HorizontalOptions="Start">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Teacher Registration" Style="{StaticResource PageTitleStyle}" />
                    <Label Text="Complete the registration form to add a new teacher to the academic roster." Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>

                <!-- 1. Professional Profile -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="1. Professional Profile" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                        <BoxView Style="{StaticResource RowDividerStyle}" />

                        <Grid ColumnDefinitions="170,*" ColumnSpacing="20">
                            <!-- Photo upload -->
                            <Border Grid.Column="0"
                                    Stroke="{StaticResource FieldBorder}"
                                    StrokeThickness="1"
                                    StrokeDashArray="4,3"
                                    Background="{StaticResource TableHeaderBackground}"
                                    Padding="12"
                                    HeightRequest="130">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPhotoTapped" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                    <controls:AvatarView x:Name="PhotoPreview" Initials="" Size="56" HorizontalOptions="Center" IsVisible="False" />
                                    <Border x:Name="PhotoIcon" WidthRequest="44" HeightRequest="44" Padding="0" StrokeThickness="0" Background="{StaticResource BrandCream}" HorizontalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22" />
                                        </Border.StrokeShape>
                                        <Label Text="&#xE722;" Style="{StaticResource IconStyle}" FontSize="18" TextColor="{StaticResource BrandPrimary}" HorizontalOptions="Center" />
                                    </Border>
                                    <Label x:Name="PhotoLabel" Text="Upload Photo" Style="{StaticResource BodyBoldStyle}" FontSize="11" HorizontalOptions="Center" />
                                    <Label Text="JPG, PNG up to 2MB" Style="{StaticResource SmallMutedStyle}" FontSize="9" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="FULL NAME" Style="{StaticResource FieldLabelStyle}" FontSize="10" />
                                    <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="36">
                                        <Entry x:Name="FullNameEntry" Placeholder="e.g. Dr. Sarah Jenkins" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="DESIGNATION" Style="{StaticResource FieldLabelStyle}" FontSize="10" />
                                        <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="36">
                                            <Picker x:Name="RolePicker" Title="Select Role" Style="{StaticResource FieldPickerStyle}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="YEARS OF EXPERIENCE" Style="{StaticResource FieldLabelStyle}" FontSize="10" />
                                        <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="36">
                                            <Entry x:Name="ExperienceEntry" Placeholder="0" Keyboard="Numeric" Style="{StaticResource FieldEntryStyle}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="DATE OF JOINING" Style="{StaticResource FieldLabelStyle}" FontSize="10" />
                                    <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="36">
                                        <DatePicker x:Name="JoiningDatePicker" FontSize="12" TextColor="{StaticResource TextHeading}" BackgroundColor="Transparent" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Contact Information -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="2. Contact Information" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                        <BoxView Style="{StaticResource RowDividerStyle}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="EMAIL ADDRESS" Style="{StaticResource FieldLabelStyle}" FontSize="10" />
                                <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="36">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="&#xE715;" Style="{StaticResource IconStyle}" FontSize="11" />
                                        <Entry Grid.Column="1" x:Name="EmailEntry" Placeholder="name@stedwards.edu" Keyboard="Email" Style="{StaticResource FieldEntryStyle}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="PRIMARY PHONE" Style="{StaticResource FieldLabelStyle}" FontSize="10" />
                                <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="36">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Label Text="&#xE717;" Style="{StaticResource IconStyle}" FontSize="11" />
                                        <Entry Grid.Column="1" x:Name="PhoneEntry" Placeholder="(555) 000-0000" Keyboard="Telephone" Style="{StaticResource FieldEntryStyle}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="RESIDENTIAL ADDRESS" Style="{StaticResource FieldLabelStyle}" FontSize="10" />
                            <Border Style="{StaticResource TextAreaBoxStyle}" HeightRequest="70">
                                <Editor x:Name="AddressEditor" Placeholder="Enter full address..." Style="{StaticResource FieldEditorStyle}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. System login details -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="3. System login Details" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                        <Grid ColumnDefinitions="90,260" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Username :" Style="{StaticResource MutedStyle}" VerticalOptions="Center" />
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBoxStyle}" HeightRequest="32">
                                <Entry x:Name="UsernameEntry" Style="{StaticResource FieldEntryStyle}" />
                            </Border>
                            <Label Grid.Row="1" Grid.Column="0" Text="Password :" Style="{StaticResource MutedStyle}" VerticalOptions="Center" />
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBoxStyle}" HeightRequest="32">
                                <Entry x:Name="PasswordEntry" IsPassword="True" Style="{StaticResource FieldEntryStyle}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <BoxView Style="{StaticResource RowDividerStyle}" />

                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                    <Button Text="Cancel" Style="{StaticResource OutlineButtonStyle}" Clicked="OnCancelClicked" />
                    <Button Text="Register Teacher" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="{StaticResource TextMuted}" Clicked="OnRegisterClicked" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
