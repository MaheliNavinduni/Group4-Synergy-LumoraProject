<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.ClassesPage"
             Title="Classes"
             BackgroundColor="{StaticResource ContentBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Academics" />

        <!-- The page, with the Manage popup sitting on top of it -->
        <Grid Grid.Column="1">

            <ScrollView>
                <VerticalStackLayout Padding="36,32" Spacing="20">

                    <VerticalStackLayout Spacing="4">
                        <controls:BreadcrumbView Section="Academics" Current="Manage Classes" />
                        <Label Text="Classes" Style="{StaticResource PageTitleStyle}" />
                        <Label Text="Every class the institute runs, its weekly times and the students in it."
                               Style="{StaticResource PageSubtitleStyle}" />
                    </VerticalStackLayout>

                    <!-- Add a class -->
                    <Border Style="{StaticResource CardStyle}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Add a Class" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                            <BoxView Style="{StaticResource RowDividerStyle}" />

                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="Subject" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                    <controls:DropDownField x:Name="SubjectPicker" Title="Select subject" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Grade" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                    <controls:DropDownField x:Name="GradePicker" Title="Select grade" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="6">
                                    <Label Text="Teacher" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                    <controls:DropDownField x:Name="TeacherPicker" Title="Select teacher" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="3" Spacing="6">
                                    <Label Text="Room" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                    <Border Style="{StaticResource FieldBoxStyle}">
                                        <Entry x:Name="RoomEntry" Placeholder="e.g. 302" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="4" Spacing="6">
                                    <Label Text="Monthly Fee (LKR)" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                    <Border Style="{StaticResource FieldBoxStyle}">
                                        <Entry x:Name="FeeEntry" Placeholder="2500" Keyboard="Numeric" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Add Class" Style="{StaticResource PrimaryButtonStyle}" HorizontalOptions="End" Clicked="OnAddClassClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- The classes -->
                    <Border Style="{StaticResource CardTightStyle}">
                        <VerticalStackLayout>
                            <Grid Padding="20,14">
                                <Label Text="All Classes" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                            </Grid>

                            <Grid Style="{StaticResource TableHeaderRowStyle}"
                                  ColumnDefinitions="1.6*,1.3*,1.3*,0.9*,0.9*,0.9*,1.4*">
                                <Label Grid.Column="0" Text="CLASS" Style="{StaticResource TableHeaderStyle}" />
                                <Label Grid.Column="1" Text="TEACHER" Style="{StaticResource TableHeaderStyle}" />
                                <Label Grid.Column="2" Text="DAYS" Style="{StaticResource TableHeaderStyle}" />
                                <Label Grid.Column="3" Text="ROOM" Style="{StaticResource TableHeaderStyle}" />
                                <Label Grid.Column="4" Text="FEE" Style="{StaticResource TableHeaderStyle}" />
                                <Label Grid.Column="5" Text="STUDENTS" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="Center" />
                                <Label Grid.Column="6" Text="" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="End" />
                            </Grid>

                            <VerticalStackLayout x:Name="ClassList">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout>
                                            <Grid Style="{StaticResource TableRowStyle}"
                                                  ColumnDefinitions="1.6*,1.3*,1.3*,0.9*,0.9*,0.9*,1.4*">
                                                <Label Grid.Column="0" Text="{Binding Name}" Style="{StaticResource TableCellBoldStyle}" FontSize="12" />
                                                <Label Grid.Column="1" Text="{Binding TeacherName}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                                <Label Grid.Column="2" Text="{Binding Days}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                                <Label Grid.Column="3" Text="{Binding Room}" Style="{StaticResource TableCellMutedStyle}" />
                                                <Label Grid.Column="4" Text="{Binding FeeText}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                                <Label Grid.Column="5" Text="{Binding StudentCount}" Style="{StaticResource TableCellStyle}" FontSize="12" HorizontalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="6" Spacing="6" HorizontalOptions="End">
                                                    <Button Text="Manage" Style="{StaticResource SmallOutlineButtonStyle}" HeightRequest="28" FontSize="10" Padding="10,0" Clicked="OnManageClicked" />
                                                    <Button Text="Close" Style="{StaticResource SmallOutlineButtonStyle}" HeightRequest="28" FontSize="10" Padding="10,0" Clicked="OnCloseClassClicked" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <BoxView Style="{StaticResource RowDividerStyle}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Label x:Name="NoClassesLabel" Text="No classes yet. Add the first one above." Style="{StaticResource MutedStyle}" Padding="20,16" IsVisible="False" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ===== Manage one class: opens over the page ===== -->
            <Grid x:Name="ManageSection"
                  BackgroundColor="#99281C12"
                  IsVisible="False">

                <!-- Clicking the dark area closes the popup -->
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseManageClicked" />
                </Grid.GestureRecognizers>

                <Border Style="{StaticResource CardStyle}"
                        Padding="0"
                        WidthRequest="900"
                        MaximumHeightRequest="680"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <!-- Swallow clicks on the card so it does not close -->
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="Auto,Auto,*">

                        <!-- Popup heading -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="24,20,24,16">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label x:Name="ManageTitle" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                <Label x:Name="ManageSubtitle" Style="{StaticResource SmallMutedStyle}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE711;"
                                   Style="{StaticResource IconStyle}"
                                   FontSize="15"
                                   VerticalOptions="Start">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCloseManageClicked" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <BoxView Grid.Row="1" Style="{StaticResource RowDividerStyle}" />

                        <ScrollView Grid.Row="2">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Padding="24,20">

                                <!-- Weekly times -->
                                <VerticalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Start">
                                    <Label Text="Weekly Times" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                                    <BoxView Style="{StaticResource RowDividerStyle}" />

                                    <!-- Day on its own row, then start and end side by side,
                                         so the three boxes line up instead of being squeezed. -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Day" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                        <controls:DropDownField x:Name="DayPicker"
                                                                Title="Select day"
                                                                BoxHeight="42"
                                                                FontSize="13" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="Start Time" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                            <controls:TimeField x:Name="StartPicker" BoxHeight="42" FontSize="13" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="End Time" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                            <controls:TimeField x:Name="EndPicker" BoxHeight="42" FontSize="13" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Button Text="Add Time Slot"
                                            Style="{StaticResource SmallPrimaryButtonStyle}"
                                            HorizontalOptions="End"
                                            Clicked="OnAddSessionClicked" />

                                    <BoxView Style="{StaticResource RowDividerStyle}" />

                                    <VerticalStackLayout x:Name="SessionList" Spacing="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="10" Padding="0,8">
                                                    <Label Grid.Column="0" Text="{Binding DayName}" Style="{StaticResource BodyBoldStyle}" FontSize="13" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding TimeRange}" Style="{StaticResource MutedStyle}" FontSize="13" VerticalOptions="Center" />
                                                    <Label Grid.Column="2" Text="&#xE74D;" Style="{StaticResource IconStyle}" FontSize="13" VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnDeleteSessionTapped" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Label x:Name="NoSessionsLabel" Text="No times added yet." Style="{StaticResource SmallMutedStyle}" IsVisible="False" />
                                </VerticalStackLayout>

                                <!-- Students -->
                                <VerticalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Start">
                                    <Label Text="Students in this Class" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                                    <BoxView Style="{StaticResource RowDividerStyle}" />

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Add a student" Style="{StaticResource FormLabelStyle}" Margin="0" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <controls:DropDownField x:Name="StudentPicker"
                                                                    Grid.Column="0"
                                                                    Title="Select student"
                                                                    BoxHeight="42"
                                                                    FontSize="13" />
                                            <Button Grid.Column="1" Text="Enrol" Style="{StaticResource SmallPrimaryButtonStyle}" HeightRequest="42" Clicked="OnEnrolClicked" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <BoxView Style="{StaticResource RowDividerStyle}" />

                                    <VerticalStackLayout x:Name="StudentList" Spacing="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,6">
                                                    <controls:AvatarView Grid.Column="0" Initials="{Binding Initials}" ImagePath="{Binding PhotoPath}" Size="30" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                        <Label Text="{Binding FullName}" Style="{StaticResource BodyBoldStyle}" FontSize="13" />
                                                        <Label Text="{Binding StudentId}" Style="{StaticResource SmallMutedStyle}" FontSize="11" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="&#xE711;" Style="{StaticResource IconStyle}" FontSize="13" VerticalOptions="Center">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnUnenrolTapped" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Label x:Name="NoStudentsLabel" Text="No students enrolled yet." Style="{StaticResource SmallMutedStyle}" IsVisible="False" />
                                </VerticalStackLayout>
                            </Grid>
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
