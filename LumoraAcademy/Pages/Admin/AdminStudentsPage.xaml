<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.AdminStudentsPage"
             Title="Students"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Students" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,32">
                <!-- Admins can also register new students -->
                <controls:StudentDirectoryView ShowRegisterButton="True" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
