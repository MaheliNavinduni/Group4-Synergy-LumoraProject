<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Admin.EditTeacherPage"
             Title="Edit Teacher Profile"
             BackgroundColor="{StaticResource ContentBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Teachers" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,32"
                                 Spacing="20"
                                 MaximumWidthRequest="1100"
                                 HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Edit Teacher Profile" Style="{StaticResource PageTitleStyle}" />
                    <Label x:Name="SubtitleLabel" Text="" Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>

                <!-- Personal details -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xE77B;" Style="{StaticResource IconStyle}" />
                            <Label Text="Personal Details" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Full Name" Style="{StaticResource SmallMutedStyle}" />
                            <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="40" Background="{StaticResource TableHeaderBackground}">
                                <Entry x:Name="FullNameEntry" Style="{StaticResource FieldEntryStyle}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="16">
                    <!-- Professional details -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xE8A5;" Style="{StaticResource IconStyle}" />
                                <Label Text="Professional Details" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Teacher ID" Style="{StaticResource SmallMutedStyle}" />
                                <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="40" Background="{StaticResource TableHeaderBackground}">
                                    <Entry x:Name="TeacherIdEntry" IsReadOnly="True" Style="{StaticResource FieldEntryStyle}" TextColor="{StaticResource TextMuted}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Total Experience (Years)" Style="{StaticResource SmallMutedStyle}" />
                                <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="40" Background="{StaticResource TableHeaderBackground}">
                                    <Entry x:Name="ExperienceEntry" Keyboard="Numeric" Style="{StaticResource FieldEntryStyle}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Joining Date" Style="{StaticResource SmallMutedStyle}" />
                                <controls:DateField x:Name="JoiningDatePicker"
                                                    BoxHeight="40"
                                                    FontSize="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Contact information -->
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="&#xE715;" Style="{StaticResource IconStyle}" />
                                <Label Text="Contact Information" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                            </HorizontalStackLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="Email Address" Style="{StaticResource SmallMutedStyle}" />
                                    <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="40" Background="{StaticResource TableHeaderBackground}">
                                        <Entry x:Name="EmailEntry" Keyboard="Email" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="Phone Number" Style="{StaticResource SmallMutedStyle}" />
                                    <Border Style="{StaticResource FieldBoxStyle}" HeightRequest="40" Background="{StaticResource TableHeaderBackground}">
                                        <Entry x:Name="PhoneEntry" Keyboard="Telephone" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Home Address" Style="{StaticResource SmallMutedStyle}" />
                                <Border Style="{StaticResource TextAreaBoxStyle}" HeightRequest="70" Background="{StaticResource TableHeaderBackground}">
                                    <Editor x:Name="AddressEditor" Style="{StaticResource FieldEditorStyle}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Login details: the name and password this teacher signs in with -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xE72E;" Style="{StaticResource IconStyle}" TextColor="{StaticResource BrandPrimary}" />
                            <Label Text="Login Details" Style="{StaticResource SectionTitleStyle}" FontSize="13" />
                        </HorizontalStackLayout>
                        <BoxView Style="{StaticResource RowDividerStyle}" />

                        <!-- Shown when the teacher has a login account -->
                        <VerticalStackLayout x:Name="LoginSection" Spacing="14">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <VerticalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="Username" Style="{StaticResource SmallMutedStyle}" />
                                    <Border Style="{StaticResource FieldBoxStyle}">
                                        <Entry x:Name="UsernameEntry" Placeholder="For example k.fernando" Style="{StaticResource FieldEntryStyle}" />
                                    </Border>
                                    <Label Text="4 to 20 characters. Letters, numbers, dots and underscores."
                                           Style="{StaticResource SmallMutedStyle}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="New Password" Style="{StaticResource SmallMutedStyle}" />
                                    <Border Style="{StaticResource FieldBoxStyle}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Entry x:Name="NewPasswordEntry"
                                                   IsPassword="True"
                                                   Placeholder="Leave blank to keep the current one"
                                                   Style="{StaticResource FieldEntryStyle}" />
                                            <Label x:Name="ShowPasswordIcon"
                                                   Grid.Column="1"
                                                   Text="&#xE7B3;"
                                                   Style="{StaticResource IconStyle}"
                                                   FontSize="13">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                    <Label Text="At least 6 characters, with one letter and one number."
                                           Style="{StaticResource SmallMutedStyle}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Border Style="{StaticResource HintCardStyle}" Padding="12">
                                <Label x:Name="LoginNoteLabel"
                                       Text="The teacher uses these to sign in. Tell them if you change anything here."
                                       Style="{StaticResource MutedStyle}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Shown when the teacher has no login account yet -->
                        <VerticalStackLayout x:Name="NoLoginSection" Spacing="10" IsVisible="False">
                            <Label Text="This teacher does not have a login account yet, so they cannot sign in."
                                   Style="{StaticResource MutedStyle}" />
                            <Button Text="Create a login for this teacher"
                                    Style="{StaticResource SmallOutlineButtonStyle}"
                                    HorizontalOptions="Start"
                                    Clicked="OnCreateLoginClicked" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                    <Button Text="Change Photo" Style="{StaticResource OutlineButtonStyle}" Clicked="OnPhotoClicked" />
                    <Button Text="Cancel" Style="{StaticResource OutlineButtonStyle}" Clicked="OnCancelClicked" />
                    <Button Text="Save Changes" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSaveClicked" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
