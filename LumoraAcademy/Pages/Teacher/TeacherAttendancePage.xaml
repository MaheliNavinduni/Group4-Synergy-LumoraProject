<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Pages.Teacher.TeacherAttendancePage"
             Title="Attendance"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="220,*">

        <controls:SidebarView Grid.Column="0"
                              ActiveItem="Attendance" />

        <ScrollView Grid.Column="1">
            <VerticalStackLayout Padding="36,32"
                                 Spacing="22">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Attendance History"
                           Style="{StaticResource PageTitleStyle}" />
                    <Label Text="Student attendance records."
                           Style="{StaticResource PageSubtitleStyle}" />
                </VerticalStackLayout>

                <controls:AttendanceTableView />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
