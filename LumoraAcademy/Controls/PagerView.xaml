<?xml version="1.0" encoding="utf-8" ?>
<!-- Prev / "Page 1 of 3" / Next. Put it under a table and call Pager.Page(list) in code. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LumoraAcademy.Controls.PagerView"
             HorizontalOptions="End"
             VerticalOptions="Center">

    <HorizontalStackLayout Spacing="8">
        <Button x:Name="PrevButton"
                Text="Prev"
                Style="{StaticResource SmallOutlineButtonStyle}"
                HeightRequest="28"
                FontSize="11"
                Clicked="OnPrevClicked" />

        <Label x:Name="PageLabel"
               Text="Page 1 of 1"
               Style="{StaticResource MutedStyle}"
               FontSize="11"
               VerticalOptions="Center" />

        <Button x:Name="NextButton"
                Text="Next"
                Style="{StaticResource SmallOutlineButtonStyle}"
                HeightRequest="28"
                FontSize="11"
                Clicked="OnNextClicked" />
    </HorizontalStackLayout>
</ContentView>
