<?xml version="1.0" encoding="utf-8" ?>
<!-- The "Daily Records" attendance table.
     Used by both the Teacher and Admin attendance pages. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:LumoraAcademy.Controls"
             x:Class="LumoraAcademy.Controls.AttendanceTableView">

    <Border Style="{StaticResource CardTightStyle}">
        <VerticalStackLayout>

            <!-- Card header with filters -->
            <Grid ColumnDefinitions="*,180,160,Auto,Auto"
                  ColumnSpacing="8"
                  Padding="20,14">
                <Label Grid.Column="0"
                       Text="Daily Records"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource BrandPrimary}"
                       VerticalOptions="Center" />

                <controls:DropDownField x:Name="ClassPicker"
                                        Grid.Column="1"
                                        Title="All classes"
                                        BoxHeight="40"
                                        FontSize="11"
                                        SelectedIndexChanged="OnFilterChanged" />

                <controls:DropDownField x:Name="MonthPicker"
                                        Grid.Column="2"
                                        Title="All dates"
                                        BoxHeight="40"
                                        FontSize="11"
                                        SelectedIndexChanged="OnFilterChanged" />

                <Label x:Name="RangeLabel"
                       Grid.Column="3"
                       Text=""
                       Style="{StaticResource SmallMutedStyle}"
                       VerticalOptions="Center" />

                <Button Grid.Column="4"
                        Text="Clear"
                        Style="{StaticResource SmallOutlineButtonStyle}"
                        Clicked="OnClearClicked" />
            </Grid>

            <!-- Table header -->
            <Grid Style="{StaticResource TableHeaderRowStyle}"
                  ColumnDefinitions="1.3*,1.3*,1.1*,0.7*,0.7*,0.7*,0.6*,0.7*,1*">
                <Label Grid.Column="0" Text="Date" Style="{StaticResource TableHeaderStyle}" />
                <Label Grid.Column="1" Text="Class" Style="{StaticResource TableHeaderStyle}" />
                <Label Grid.Column="2" Text="Subject" Style="{StaticResource TableHeaderStyle}" />
                <Label Grid.Column="3" Text="Enrolled" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="Center" />
                <Label Grid.Column="4" Text="Present" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="Center" />
                <Label Grid.Column="5" Text="Absent" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="Center" />
                <Label Grid.Column="6" Text="Late" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="Center" />
                <Label Grid.Column="7" Text="Not rec." Style="{StaticResource TableHeaderStyle}" HorizontalOptions="Center" />
                <Label Grid.Column="8" Text="Status" Style="{StaticResource TableHeaderStyle}" HorizontalOptions="Center" />
            </Grid>

            <!-- Table rows -->
            <VerticalStackLayout x:Name="RowList">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Grid Style="{StaticResource TableRowStyle}"
                                  ColumnDefinitions="1.3*,1.3*,1.1*,0.7*,0.7*,0.7*,0.6*,0.7*,1*">
                                <Label Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource TableCellStyle}" FontSize="12" TextColor="{StaticResource BrandPrimary}" />
                                <Label Grid.Column="1" Text="{Binding ClassName}" Style="{StaticResource TableCellStyle}" FontSize="12" TextColor="{StaticResource BrandPrimary}" />
                                <Label Grid.Column="2" Text="{Binding SubjectName}" Style="{StaticResource TableCellStyle}" FontSize="12" />
                                <Label Grid.Column="3" Text="{Binding Enrolled}" Style="{StaticResource TableCellStyle}" FontSize="12" HorizontalOptions="Center" TextColor="{StaticResource BrandPrimary}" />
                                <Label Grid.Column="4" Text="{Binding Present}" Style="{StaticResource TableCellBoldStyle}" FontSize="12" HorizontalOptions="Center" TextColor="{StaticResource StatusGreenText}" />
                                <Label Grid.Column="5" Text="{Binding Absent}" Style="{StaticResource TableCellBoldStyle}" FontSize="12" HorizontalOptions="Center" TextColor="{StaticResource StatusRedText}" />
                                <Label Grid.Column="6" Text="{Binding Late}" Style="{StaticResource TableCellStyle}" FontSize="12" HorizontalOptions="Center" TextColor="{StaticResource StatusYellowText}" />
                                <Label Grid.Column="7" Text="{Binding NotRecorded}" Style="{StaticResource TableCellStyle}" FontSize="12" HorizontalOptions="Center" TextColor="{StaticResource TextLight}" />
                                <controls:StatusBadge Grid.Column="8" Text="{Binding Status}" HorizontalOptions="Center" />
                            </Grid>
                            <BoxView Style="{StaticResource RowDividerStyle}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Footer with paging -->
            <Grid ColumnDefinitions="*,Auto"
                  Padding="20,12">
                <Label Grid.Column="0"
                       x:Name="CountLabel"
                       Text=""
                       Style="{StaticResource SmallMutedStyle}"
                       VerticalOptions="Center" />
                <controls:PagerView x:Name="Pager" Grid.Column="1" PageChanged="OnPageChanged" />
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>
