<?xml version="1.0" encoding="utf-8" ?>
<!-- A small coloured pill such as "Active", "Paid" or "Excellent".
     The colour is chosen automatically from the text (see StatusBadge.xaml.cs). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LumoraAcademy.Controls.StatusBadge"
             HorizontalOptions="Start"
             VerticalOptions="Center">

    <Border x:Name="Pill"
            Padding="10,3"
            StrokeThickness="0"
            Background="{StaticResource StatusGrayBg}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>

        <Label x:Name="PillText"
               FontSize="10"
               FontAttributes="Bold"
               TextColor="{StaticResource StatusGrayText}"
               VerticalOptions="Center" />
    </Border>
</ContentView>
