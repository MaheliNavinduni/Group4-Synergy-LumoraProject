<?xml version="1.0" encoding="UTF-8" ?>
<!-- Brand colours and shared styles for Lumora Academy.
     Change a colour here and it changes everywhere. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== The Lumora brown scale =====
         Every colour in the system comes from this one scale, so the whole
         app looks like one product. Brown900 is the darkest, Brown50 the
         lightest. The numbers work like paint shades: bigger = darker. -->
    <Color x:Key="Brown900">#3E2B1C</Color>
    <Color x:Key="Brown800">#4F3726</Color>
    <Color x:Key="Brown700">#63472F</Color>
    <Color x:Key="Brown600">#7C5A3A</Color>
    <Color x:Key="Brown500">#9C7048</Color>
    <Color x:Key="Brown400">#B87F52</Color>
    <Color x:Key="Brown300">#CFA075</Color>
    <Color x:Key="Brown200">#E2C4A3</Color>
    <Color x:Key="Brown100">#F0DFCB</Color>
    <Color x:Key="Brown50">#FBEFE3</Color>

    <!-- The warm yellow from the logo, used sparingly as a highlight -->
    <Color x:Key="AccentGold">#E8B44A</Color>
    <Color x:Key="AccentGoldSoft">#FBE6BC</Color>

    <!-- ===== Main brand colours (names used all over the app) ===== -->
    <Color x:Key="BrandPrimary">#B87F52</Color>
    <Color x:Key="BrandPrimaryDark">#8B6844</Color>
    <Color x:Key="BrandCream">#FBEFE3</Color>
    <Color x:Key="BrandBrownDeep">#63472F</Color>

    <!-- ===== Chart colours =====
         Five brown shades that sit well next to each other, for bar charts
         and for the coloured statistic cards. -->
    <Color x:Key="Chart1">#4F3726</Color>
    <Color x:Key="Chart2">#7C5A3A</Color>
    <Color x:Key="Chart3">#B87F52</Color>
    <Color x:Key="Chart4">#CFA075</Color>
    <Color x:Key="Chart5">#E2C4A3</Color>
    <Color x:Key="ChartTrack">#F0DFCB</Color>

    <!-- ===== The side menu ===== -->
    <Color x:Key="SidebarBackground">#4F3726</Color>
    <Color x:Key="SidebarBackgroundDeep">#3E2B1C</Color>
    <Color x:Key="SidebarText">#EADCCB</Color>
    <Color x:Key="SidebarTextDim">#BFA88F</Color>
    <Color x:Key="SidebarDivider">#63472F</Color>
    <Color x:Key="SidebarHover">#63472F</Color>

    <!-- ===== Text colours ===== -->
    <Color x:Key="TextHeading">#2B1F16</Color>
    <Color x:Key="TextBody">#6B5544</Color>
    <Color x:Key="TextMuted">#7A6A5B</Color>
    <Color x:Key="TextLight">#A1907F</Color>
    <Color x:Key="TextOnDark">#FFFFFF</Color>
    <Color x:Key="TextLink">#7C5A3A</Color>

    <!-- ===== Surfaces ===== -->
    <Color x:Key="PageBackground">#FFFFFF</Color>
    <Color x:Key="ContentBackground">#FAF6F1</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <!-- Borders are deliberately strong enough to see at a glance -->
    <Color x:Key="CardBorder">#DFD2C3</Color>
    <Color x:Key="FieldBorder">#C8B8A5</Color>
    <Color x:Key="DividerLine">#E7DCD0</Color>

    <Color x:Key="TableHeaderBackground">#F6F0E9</Color>
    <Color x:Key="RowHover">#FBF3EA</Color>

    <!-- ===== Status colours (badge background / badge text) =====
         Green, red and amber keep their usual meaning, but every one of them
         is warmed slightly so the badges sit comfortably in a brown system.
         Blue and grey have been replaced by tan and stone for the same reason. -->
    <Color x:Key="StatusGreenBg">#E2F0DC</Color>
    <Color x:Key="StatusGreenText">#2F5D2B</Color>
    <Color x:Key="StatusRedBg">#F8DFD8</Color>
    <Color x:Key="StatusRedText">#8C3A28</Color>
    <Color x:Key="StatusYellowBg">#FBE6BC</Color>
    <Color x:Key="StatusYellowText">#7A5411</Color>
    <Color x:Key="StatusBlueBg">#F0DFCB</Color>
    <Color x:Key="StatusBlueText">#63472F</Color>
    <Color x:Key="StatusGrayBg">#F1EAE2</Color>
    <Color x:Key="StatusGrayText">#5C4A3B</Color>
    <Color x:Key="StatusOrangeBg">#FAE0C4</Color>
    <Color x:Key="StatusOrangeText">#8A4B1B</Color>
    <Color x:Key="StatusPurpleBg">#EDE0E6</Color>
    <Color x:Key="StatusPurpleText">#6B3A55</Color>

    <!-- ===== Cards ===== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
        <!-- A soft shadow lifts the card off the page, so the edge is easy to see -->
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{StaticResource Brown900}"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardTightStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ===== Text styles ===== -->
    <Style x:Key="PageTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="CardBodyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="TextColor" Value="{StaticResource TextBody}" />
    </Style>

    <Style x:Key="BodyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="BodyBoldStyle" TargetType="Label" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="MutedStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="SmallMutedStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TextLight}" />
    </Style>

    <Style x:Key="LinkStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="FormLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="TableHeaderStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TableCellStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TableCellBoldStyle" TargetType="Label" BasedOn="{StaticResource TableCellStyle}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TableCellMutedStyle" TargetType="Label" BasedOn="{StaticResource TableCellStyle}">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Icons use the "Segoe MDL2 Assets" font that is built into Windows -->
    <Style x:Key="IconStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===== Table rows ===== -->
    <Style x:Key="TableHeaderRowStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource TableHeaderBackground}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="TableRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="RowDividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource DividerLine}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="FieldBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource FieldBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextAreaBoxStyle" TargetType="Border" BasedOn="{StaticResource FieldBoxStyle}">
        <Setter Property="HeightRequest" Value="90" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="FieldEntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="13" />
        <!-- Without these the text box is squeezed by the box around it
             and what the user types becomes impossible to read. -->
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="FieldEditorStyle" TargetType="Editor">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
    </Style>

    <Style x:Key="FieldPickerStyle" TargetType="Picker">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="TitleColor" Value="{StaticResource TextLight}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- PointerOver runs when the mouse is over the button, so the user can
         see straight away that it can be clicked. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="Scale" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimaryDark}" />
                            <Setter Property="Scale" Value="1.02" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandBrownDeep}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource FieldBorder}" />
                            <Setter Property="TextColor" Value="{StaticResource TextLight}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SmallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="BorderColor" Value="{StaticResource FieldBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                            <Setter Property="BorderColor" Value="{StaticResource FieldBorder}" />
                            <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RowHover}" />
                            <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandCream}" />
                            <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TextLight}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SmallOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RowHover}" />
                            <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===== Pagination ===== -->
    <Style x:Key="PageNumberStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="26" />
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="{StaticResource FieldBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageNumberActiveStyle" TargetType="Border" BasedOn="{StaticResource PageNumberStyle}">
        <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
    </Style>
    <!-- ===== Form helpers ===== -->

    <!-- The red star beside a field the user must fill in. -->
    <Style x:Key="RequiredMarkStyle" TargetType="Label">
        <Setter Property="Text" Value="*" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource StatusRedText}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- The message shown on a form when something the user typed is wrong. -->
    <Style x:Key="ErrorBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusRedBg}" />
        <Setter Property="Stroke" Value="{StaticResource StatusRedBg}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource StatusRedText}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- A soft note card, used to fill side space with something useful. -->
    <Style x:Key="HintCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandCream}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
