<?xml version="1.0" encoding="UTF-8" ?>
<!-- Brand colours and shared styles for Lumora Academy.
     Change a colour here and it changes everywhere. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Main brand colours ===== -->
    <Color x:Key="BrandPrimary">#B87F52</Color>
    <Color x:Key="BrandPrimaryDark">#8B6844</Color>
    <Color x:Key="BrandCream">#FBEFE3</Color>
    <Color x:Key="BrandBrownDeep">#6B4E31</Color>

    <!-- ===== Text colours ===== -->
    <Color x:Key="TextHeading">#1C1917</Color>
    <Color x:Key="TextBody">#8B7355</Color>
    <Color x:Key="TextMuted">#6B7280</Color>
    <Color x:Key="TextLight">#9CA3AF</Color>
    <Color x:Key="TextOnDark">#FFFFFF</Color>
    <Color x:Key="TextLink">#1D4ED8</Color>

    <!-- ===== Surfaces ===== -->
    <Color x:Key="PageBackground">#FFFFFF</Color>
    <Color x:Key="ContentBackground">#FAFAF9</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBorder">#E7E1DA</Color>
    <Color x:Key="FieldBorder">#D8D2CB</Color>
    <Color x:Key="DividerLine">#EDE9E4</Color>
    <Color x:Key="TableHeaderBackground">#F9FAFB</Color>
    <Color x:Key="RowHover">#FDF8F3</Color>

    <!-- ===== Status colours (badge background / badge text) ===== -->
    <Color x:Key="StatusGreenBg">#DCFCE7</Color>
    <Color x:Key="StatusGreenText">#166534</Color>
    <Color x:Key="StatusRedBg">#FEE2E2</Color>
    <Color x:Key="StatusRedText">#991B1B</Color>
    <Color x:Key="StatusYellowBg">#FEF9C3</Color>
    <Color x:Key="StatusYellowText">#854D0E</Color>
    <Color x:Key="StatusBlueBg">#DBEAFE</Color>
    <Color x:Key="StatusBlueText">#1E40AF</Color>
    <Color x:Key="StatusGrayBg">#F3F4F6</Color>
    <Color x:Key="StatusGrayText">#374151</Color>
    <Color x:Key="StatusOrangeBg">#FFEDD5</Color>
    <Color x:Key="StatusOrangeText">#9A3412</Color>
    <Color x:Key="StatusPurpleBg">#EDE9FE</Color>
    <Color x:Key="StatusPurpleText">#5B21B6</Color>

    <!-- ===== Cards ===== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardTightStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ===== Text styles ===== -->
    <Style x:Key="PageTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="CardBodyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="TextColor" Value="{StaticResource TextBody}" />
    </Style>

    <Style x:Key="BodyStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="BodyBoldStyle" TargetType="Label" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="MutedStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="SmallMutedStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource TextLight}" />
    </Style>

    <Style x:Key="LinkStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
    </Style>

    <Style x:Key="FormLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="TableHeaderStyle" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TableCellStyle" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="TableCellBoldStyle" TargetType="Label" BasedOn="{StaticResource TableCellStyle}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="TableCellMutedStyle" TargetType="Label" BasedOn="{StaticResource TableCellStyle}">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Icons use the "Segoe MDL2 Assets" font that is built into Windows -->
    <Style x:Key="IconStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===== Table rows ===== -->
    <Style x:Key="TableHeaderRowStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource TableHeaderBackground}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="TableRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="RowDividerStyle" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource DividerLine}" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="FieldBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Stroke" Value="{StaticResource FieldBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextAreaBoxStyle" TargetType="Border" BasedOn="{StaticResource FieldBoxStyle}">
        <Setter Property="HeightRequest" Value="90" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="FieldEntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="13" />
        <!-- Without these the text box is squeezed by the box around it
             and what the user types becomes impossible to read. -->
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="FieldEditorStyle" TargetType="Editor">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextLight}" />
    </Style>

    <Style x:Key="FieldPickerStyle" TargetType="Picker">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="TitleColor" Value="{StaticResource TextLight}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ===== Buttons ===== -->
    <!-- PointerOver runs when the mouse is over the button, so the user can
         see straight away that it can be clicked. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource TextOnDark}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="Scale" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandPrimaryDark}" />
                            <Setter Property="Scale" Value="1.02" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandBrownDeep}" />
                            <Setter Property="Scale" Value="0.98" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource FieldBorder}" />
                            <Setter Property="TextColor" Value="{StaticResource TextLight}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SmallPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="34" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
        <Setter Property="BorderColor" Value="{StaticResource FieldBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
                            <Setter Property="BorderColor" Value="{StaticResource FieldBorder}" />
                            <Setter Property="TextColor" Value="{StaticResource TextHeading}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RowHover}" />
                            <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                            <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource BrandCream}" />
                            <Setter Property="BorderColor" Value="{StaticResource BrandPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource TextLight}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SmallOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource RowHover}" />
                            <Setter Property="TextColor" Value="{StaticResource BrandPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===== Pagination ===== -->
    <Style x:Key="PageNumberStyle" TargetType="Border">
        <Setter Property="WidthRequest" Value="26" />
        <Setter Property="HeightRequest" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="{StaticResource FieldBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageNumberActiveStyle" TargetType="Border" BasedOn="{StaticResource PageNumberStyle}">
        <Setter Property="Background" Value="{StaticResource BrandPrimary}" />
        <Setter Property="Stroke" Value="{StaticResource BrandPrimary}" />
    </Style>
    <!-- ===== Form helpers ===== -->

    <!-- The red star beside a field the user must fill in. -->
    <Style x:Key="RequiredMarkStyle" TargetType="Label">
        <Setter Property="Text" Value="*" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource StatusRedText}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- The message shown on a form when something the user typed is wrong. -->
    <Style x:Key="ErrorBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusRedBg}" />
        <Setter Property="Stroke" Value="{StaticResource StatusRedBg}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource StatusRedText}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- A soft note card, used to fill side space with something useful. -->
    <Style x:Key="HintCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandCream}" />
        <Setter Property="Stroke" Value="{StaticResource CardBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
